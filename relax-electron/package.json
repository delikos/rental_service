{
  "name": "relax-wypozyczalnia",
  "version": "1.0.0",
  "description": "System Wypożyczalni Relax",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "pl.relax.wypozyczalnia",
    "productName": "Relax Wypożyczalnia",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "src/**/*"],
    "win":   { "target": "nsis", "icon": "assets/icon.ico" },
    "mac":   { "target": "dmg",  "icon": "assets/icon.icns" },
    "linux": { "target": "AppImage", "icon": "assets/icon.png" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "language": "1045"
    }
  },
  "dependencies": {
    "sql.js": "^1.10.3"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
